# The Supabase client runs entirely in the browser (README.md), so both
# values below are public/client-safe by design — this is the anon /
# publishable key, never the service-role secret key. Get these from your
# Supabase project's Settings -> API page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Sentry error monitoring. The DSN is client-safe by design (it's meant to
# be embedded in the browser bundle) — SENTRY_DSN reuses the same value
# server-side. SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN are build-time
# only (source-map upload) and never reach the browser; the auth token is
# a real secret — create it at https://sentry.io/settings/account/api/auth-tokens/
# with project:releases scope, never commit its real value.
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-auth-token
