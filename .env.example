# The Supabase client runs entirely in the browser (README.md), so both
# values below are public/client-safe by design — this is the anon /
# publishable key, never the service-role secret key. Get these from your
# Supabase project's Settings -> API page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
